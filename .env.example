# Ports exposés en local (volontairement peu communs pour éviter les
# collisions avec les autres services déjà lancés sur la machine).
PROXY_PORT=45321
ADMIN_PORT=45322

# Clés API des fournisseurs LLM configurés dans config/providers.yaml.
# À renseigner par l'utilisateur : les coûts de token sont à sa charge.
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Optionnel : URL d'un collecteur OpenTelemetry (OTLP/HTTP) vers lequel
# exporter les traces d'observabilité. Laisser vide pour désactiver.
# Ex : OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Détection & masquage PII/secrets (email, IBAN, carte bancaire, clés API).
# Actif par défaut. Mettre "off" pour désactiver — décision serveur
# uniquement, jamais surchageable par un client.
# PROXY_PII_MASKING=off

# Journal d'audit persistant (Étape 5 — rapport de conformité). Monté en
# volume via docker-compose (./data:/app/data), survit aux redémarrages.
# PROXY_AUDIT_LOG=data/audit.jsonl

# Fallback / Failover (Étape 7) : chemin du fichier de correspondances.
# PROXY_FALLBACK=config/fallback.yaml
